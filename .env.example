# ==============================================================================
# Acme Corp Internal KB Assistant — Environment Configuration Template
# ==============================================================================
# ⚠️ SECURITY WARNING: NEVER COMMIT SENSITIVE KEYS OR PASSWORDS TO GIT!
# This file (.env.example) is committed to Git as a schema template.
# To configure your local environment:
#     1. Copy this file: cp .env.example .env
#     2. Verify .env is ignored: git check-ignore .env
# ==============================================================================

# LLM Provider Configuration (Default: 100% Local Ollama)
# Supported options: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Engine (Default: local FastEmbed via CPU ONNX)
# Supported options: local | ollama | openai
EMBEDDINGS_PROVIDER=local

# Local File & Database Storage Paths
CHROMA_DIR=chroma_db
DOCS_DIR=data/docs
TICKETS_FILE=tickets.jsonl
LOG_FILE=assistant.log

# Cloud API Keys (OPTIONAL — Leave blank when running 100% locally with Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
